# Proxmox connection
proxmox_api_url          = "https://pve.example.com:8006"
proxmox_api_token_id     = "automation@pam!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_api_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_node             = "pve"

# Cluster configuration
cluster_name = "my-cluster"

# Worker configuration
worker_count     = 2
worker_cpu_cores = 4
worker_memory_mb = 8192
worker_disk_gb   = 100

# Optional: explicit MAC addresses (omit to let Proxmox assign)
# worker_mac_addresses = [
#   "52:54:00:AA:BB:CC",
#   "52:54:00:DD:EE:FF",
# ]

# Optional: SMBIOS serial
# worker_serial = "talos-worker-"
